# vast-ltx-worker environment.
# Set these on the Vast endpoint TEMPLATE (they're read at cold start by provision.sh / model_server.py).
# Only HF_TOKEN is strictly required; everything else has a working default.

# --- Required ---
# Hugging Face token that has ACCEPTED the gated google/gemma-3-12b license. Without it the text
# encoder download fails and the model server can't start. (huggingface-cli reads HF_TOKEN from env.)
HF_TOKEN=

# --- Weights location ---
# Where weights are stored. Point at a PERSISTENT /data volume to keep them warm across cold starts
# (provision.sh skips any file/dir that already exists — the biggest cold-start win).
LTX_MODELS_DIR=/workspace/models
# Individual paths are derived from LTX_MODELS_DIR; override only to point at pre-mounted weights.
# LTX_CKPT=/workspace/models/checkpoints/ltx-2.3-22b-dev.safetensors
# LTX_GEMMA=/workspace/models/text_encoders/gemma-3-12b-it-qat-q4_0-unquantized
# LTX_LORA=/workspace/models/loras/ltx-2.3-22b-distilled-lora-384-1.1.safetensors
# LTX_UPSCALER=/workspace/models/upscalers/ltx-2.3-spatial-upscaler-x2-1.1.safetensors

# --- GPU fit (quantization / offload) ---
# ""        = bf16, resident, needs ~80GB VRAM (default).
# fp8-cast  = lossless fp8, fits ~48GB; combine with LTX_OFFLOAD for smaller cards.
LTX_QUANT=
# none (default) | modes that push the text encoder / blocks to CPU for cheaper GPUs.
LTX_OFFLOAD=none

# --- Pipeline mode ---
# one_stage (default) = TI2VidOneStagePipeline, renders at the REQUEST's height/width/steps.
# two_stage           = DistilledPipeline + 2x upscaler; renders at LTX_TARGET_* below (request dims IGNORED).
LTX_PIPELINE=one_stage
# Final resolution for two_stage ONLY (one_stage ignores these and uses the request's dims):
LTX_TARGET_HEIGHT=1024
LTX_TARGET_WIDTH=1536

# --- Logging ---
# Where the model server writes stdout/stderr. The PyWorker tails this file for the readiness tokens
# ("Application startup complete" / "PIPELINE_READY") and the CLIP timing lines.
MODEL_LOG=/var/log/portal/ltx.log
